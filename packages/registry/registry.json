    {
      "name": "animations",
      "type": "registry:style",
      "title": "Animations",
      "description": "SevenUI's enter/exit animation utilities (animate-in/out, fade, zoom, slide) used by the overlay components.",
      "css": {
        "@utility animate-in": {
          "animation": "enter var(--tw-duration, 0.15s) var(--tw-ease, ease) both"
        },
        "@utility animate-out": {
          "animation": "exit var(--tw-duration, 0.15s) var(--tw-ease, ease) both"
        },
        "@utility fade-in-*": {
          "--enter-opacity": "calc(--value(number) / 100)"
        },
        "@utility fade-out-*": {
          "--exit-opacity": "calc(--value(number) / 100)"
        },
        "@utility zoom-in-*": {
          "--enter-scale": "calc(--value(number) / 100)"
        },
        "@utility zoom-out-*": {
          "--exit-scale": "calc(--value(number) / 100)"
        },
        "@utility slide-in-from-top-*": {
          "--enter-translate-y": "calc(var(--spacing) * --value(number) * -1)"
        },
        "@utility slide-in-from-bottom-*": {
          "--enter-translate-y": "calc(var(--spacing) * --value(number))"
        },
        "@utility slide-in-from-left-*": {
          "--enter-translate-x": "calc(var(--spacing) * --value(number) * -1)"
        },
        "@utility slide-in-from-right-*": {
          "--enter-translate-x": "calc(var(--spacing) * --value(number))"
        },
        "@utility slide-out-to-top-*": {
          "--exit-translate-y": "calc(var(--spacing) * --value(number) * -1)"
        },
        "@utility slide-out-to-bottom-*": {
          "--exit-translate-y": "calc(var(--spacing) * --value(number))"
        },
        "@utility slide-out-to-left-*": {
          "--exit-translate-x": "calc(var(--spacing) * --value(number) * -1)"
        },
        "@utility slide-out-to-right-*": {
          "--exit-translate-x": "calc(var(--spacing) * --value(number))"
        },
        "@keyframes enter": {
          "from": {
            "opacity": "var(--enter-opacity, 1)",
            "transform": "translate3d(var(--enter-translate-x, 0), var(--enter-translate-y, 0), 0) scale3d(var(--enter-scale, 1), var(--enter-scale, 1), 1)"
          }
        },
        "@keyframes exit": {
          "to": {
            "opacity": "var(--exit-opacity, 1)",
            "transform": "translate3d(var(--exit-translate-x, 0), var(--exit-translate-y, 0), 0) scale3d(var(--exit-scale, 1), var(--exit-scale, 1), 1)"
          }
        }
      }
