{
  "name": "sevenui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/ui-sdk-flavour.mjs examples && pnpm --filter @sevenui/web dev",
    "build": "pnpm --filter @sevenui/web build",
    "start": "pnpm --filter @sevenui/web start",
    "build:registry": "pnpm --filter @sevenui/web build:registry",
    "preview": "pnpm --filter @sevenui/web start",
    "lint": "biome lint",
    "typecheck": "node scripts/ui-sdk-flavour.mjs examples && pnpm -r typecheck",
    "check:registry": "node scripts/check-registry.mjs",
    "check:docs-imports": "node scripts/check-docs-imports.mjs",
    "check:ui-sdk-compat": "node scripts/check-ui-sdk-compat.mjs",
    "check:ui-sdk-notes": "node scripts/check-ui-sdk-notes.mjs",
    "ui-sdk:examples": "node scripts/ui-sdk-flavour.mjs examples",
    "check:home": "node scripts/check-home.mjs",
    "test": "pnpm --filter @sevenui/registry test && pnpm --filter @sevenui/presets test",
    "test:smoke": "bash scripts/smoke-test.sh",
    "inventory": "node scripts/route-inventory.mjs",
    "extract": "node scripts/extract-page-features.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.41.0",
    "playwright": "1.63.0"
  }
}
