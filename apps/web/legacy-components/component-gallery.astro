---
// Two-column shell for /components pages: sticky component list on the
// left (docs-style structural border), content on the right. The sticky
// offset mirrors blocks-sidebar.astro / Blume's own docs sidebar.
//
// Desktop only. Below `lg` the same tree is reached through the header's nav
// drawer (site-drawer.astro), which every /components page renders — the list
// used to stack above the content on mobile, pushing the page down.
import ComponentGalleryNav from "./component-gallery-nav.astro";

interface Props {
  active?: string;
}
const { active } = Astro.props;
---

<div class="lg:grid lg:grid-cols-[240px_minmax(0,1fr)]">
  <aside
    class="hidden lg:sticky lg:top-16 lg:block lg:h-[calc(100dvh-4rem)] lg:overflow-y-auto lg:border-r lg:border-border lg:px-5 lg:py-8"
  >
    <ComponentGalleryNav active={active} />
  </aside>
  <div class="min-w-0"><slot /></div>
</div>
