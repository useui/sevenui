---
// Category sidebar for the /blocks gallery (directory, group, and category
// pages). One <details> per group listing its categories with block counts.
// Desktop only: an always-visible left column, flush against the viewport
// edge, separated from the content column by a border (docs-style structural
// line, not the landing's decorative rail/crop-mark apparatus), and sticky so
// it stays visible while the content scrolls. Below `lg` the same tree is
// reached through the header's nav drawer (site-drawer.astro), which every
// /blocks page renders — it used to be a "Categories" disclosure buried in the
// page body here, which the header hamburger knew nothing about.
// The sticky offset (`top-16` / `100dvh-4rem`) mirrors Blume's own docs
// sidebar (node_modules/blume/src/components/layout/RootLayout.astro),
// whose nav drawer uses the same `lg:sticky lg:top-16
// lg:h-[calc(100dvh-4rem)]` pairing for its 4rem-tall header.
//
// Navigation only. The theme customizer used to hang below this tree; it now
// lives in blocks-theme-dock.astro, rendered by the three /blocks pages. Do not
// render the dock from here — it must exist exactly once per page.
import BlocksSidebarNav from "./blocks-sidebar-nav.astro";

interface Props {
  activeGroup?: string;
  activeCategory?: string;
}
const { activeGroup, activeCategory } = Astro.props;
---

<div
  class="hidden lg:sticky lg:top-16 lg:block lg:h-[calc(100dvh-4rem)] lg:overflow-y-auto lg:border-r lg:border-border lg:px-5 lg:py-8"
>
  <nav aria-label="Block categories">
    <BlocksSidebarNav activeGroup={activeGroup} activeCategory={activeCategory} />
  </nav>
</div>
