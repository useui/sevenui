---
import { EN_UI } from "blume/core/i18n-ui.ts";
import data from "blume:data";
import SiteDrawerTabs from "./site-drawer-tabs.astro";

interface Props {
  /** Current page route, in final URL space (matches `page.route`). */
  route: string;
}

// The one mobile nav drawer for every custom (PageLayout) page. Blume ships a
// tabs-only drawer of its own, but it renders inside PageLayout with no slot to
// extend, so a page's own tree (block categories, the component list) could
// never reach it — /blocks fell back to an inline <details> buried in the page
// body and /components had no mobile treatment at all.
//
// This takes that drawer's place: pages leave `tabs` out of their `navigation`
// prop, which switches PageLayout's drawer off (it is gated on
// `navigation.tabs.length > 0`), and render this instead with their tree in the
// slot. The header still shows the tabs and the hamburger — it injects
// SITE_TABS itself, independent of the navigation prop.
//
// Exactly one `[data-blume-nav-drawer]` may exist per page: blume's
// `syncDrawerInert` (components/layout/drawer-inert.ts) uses `querySelector`,
// so a second drawer would never be un-inerted and its links would stay
// unreachable. Hence switching PageLayout's off rather than adding to it.
//
// Open/close is pure CSS off `[data-blume-nav-open]` on <html>, so the header's
// existing toggle script drives this with no changes: it owns the drawer-top
// measurement, the scroll lock, and the close-on-resize past `lg`.
const { route } = Astro.props;
const n = EN_UI.nav;
const hasTree = Astro.slots.has("default");
---

<aside
  aria-label={n.navigation}
  class="fixed top-[var(--blume-drawer-top,4rem)] start-0 z-[35] h-[calc(100dvh-var(--blume-drawer-top,4rem))] w-64 max-w-[80vw] -translate-x-[105%] overflow-y-auto border-border border-e bg-background px-5 pt-4 pb-6 transition-transform rtl:translate-x-[105%] [:where([data-blume-nav-open])_&]:translate-x-0! lg:hidden"
  data-blume-nav-drawer
>
  <div class:list={[hasTree && "mb-4 border-border border-b pb-4"]}>
    <SiteDrawerTabs label={n.sections} root={data.navigation.root} route={route} />
  </div>
  <slot />
</aside>
<button
  aria-label={n.closeNavigation}
  class="fixed inset-0 z-[30] hidden cursor-pointer border-0 bg-black/40 [:where([data-blume-nav-open])_&]:block lg:hidden"
  data-blume-nav-toggle
  type="button"
></button>
