---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Header from "../../components/blume/Header.astro";
import BlocksSidebarNav from "../../components/blocks-sidebar-nav.astro";
import BlocksSidebar from "../../components/blocks-sidebar.astro";
import BlocksThemeDock from "../../components/blocks-theme-dock.astro";
import CategoryCard from "../../components/category-card.astro";
import ProOffer from "../../components/pro-offer.astro";
import SiteDrawer from "../../components/site-drawer.astro";
import SiteFooter from "../../components/site-footer.astro";
import { lucideIcon } from "../../lib/pro-manifest";
import { groups } from "./_data";

const { config } = data;

const description = "Production-ready pro blocks built on SevenUI components.";

// Computed (not hardcoded) so the directory's count sentence stays correct
// as groups/categories/items change — mirrors the group/category pages'
// own "{description} {count} in this {group|category}." pattern.
const totalBlocks = groups.reduce((sum, group) => sum + group.items.length, 0);
const totalCategories = groups.reduce((sum, group) => sum + group.categories.length, 0);

// No tabs in the navigation prop: PageLayout gates its built-in tabs-only
// drawer on `navigation.tabs.length > 0`, and SiteDrawer replaces it below
// (blume's `syncDrawerInert` uses `querySelector`, so only one
// `[data-blume-nav-drawer]` may exist per page). The header is unaffected — it
// injects the site tabs itself rather than reading this prop.
const navigation = {
  ...data.navigation,
  tabs: [],
};
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: "Blocks — SevenUI", description, route: "/blocks" }}
  layout={{ Header }}
>
  <div class="lg:grid lg:grid-cols-[260px_minmax(0,1fr)]">
    <BlocksSidebar />
    <div class="min-w-0">
      <header class="border-b border-border px-6 py-12 lg:px-10">
        <div class="max-w-2xl">
          <h1 class="text-3xl font-semibold tracking-tight">Blocks</h1>
          <p class="mt-2 text-muted-foreground">
            {description} {totalBlocks} {totalBlocks === 1 ? "block" : "blocks"} in {totalCategories} {totalCategories === 1 ? "category" : "categories"}.
          </p>
        </div>
      </header>
      <ProOffer />
      <div class="px-6 py-12 lg:px-10">
        <div class="flex max-w-5xl flex-col gap-12">
          {groups.map((group) => {
            const GroupIcon = group.icon ? lucideIcon(group.icon) : null;
            return (
              <section>
                <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
                  {GroupIcon && <GroupIcon class="size-4 text-muted-foreground" aria-hidden="true" />}
                  <a href={`/blocks/${group.id}`} class="hover:underline">{group.label}</a>
                  <span class="text-sm font-normal text-muted-foreground">{group.items.length}</span>
                </h2>
                <p class="mt-1 text-sm text-muted-foreground">{group.description}</p>
                <div class="mt-4 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
                  {group.categories.map((category) => (
                    <CategoryCard group={group.id} category={category} />
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      </div>
      <BlocksThemeDock />
    </div>
  </div>
  <SiteDrawer route="/blocks">
    <nav aria-label="Block categories"><BlocksSidebarNav /></nav>
  </SiteDrawer>
  <footer slot="footer"><SiteFooter /></footer>
</PageLayout>
