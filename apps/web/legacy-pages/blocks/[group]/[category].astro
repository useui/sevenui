---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Header from "../../../components/blume/Header.astro";
import BlockFrame from "../../../components/block-frame.astro";
import BlocksPrefs from "../../../components/blocks-prefs.astro";
import BlocksSidebarNav from "../../../components/blocks-sidebar-nav.astro";
import BlocksSidebar from "../../../components/blocks-sidebar.astro";
import BlocksThemeDock from "../../../components/blocks-theme-dock.astro";
import ProOffer from "../../../components/pro-offer.astro";
import SiteDrawer from "../../../components/site-drawer.astro";
import SiteFooter from "../../../components/site-footer.astro";
import { groups } from "../_data";

export function getStaticPaths() {
  return groups.flatMap((group) =>
    group.categories.map((category) => ({
      params: { group: group.id, category: category.id },
    })),
  );
}

const { group: groupId, category: categoryId } = Astro.params;
const group = groups.find((entry) => entry.id === groupId)!;
const category = group.categories.find((entry) => entry.id === categoryId)!;
const { config } = data;

// No tabs in the navigation prop: PageLayout gates its built-in tabs-only
// drawer on `navigation.tabs.length > 0`, and SiteDrawer replaces it below
// (blume's `syncDrawerInert` uses `querySelector`, so only one
// `[data-blume-nav-drawer]` may exist per page). The header is unaffected — it
// injects the site tabs itself rather than reading this prop.
const navigation = {
  ...data.navigation,
  tabs: [],
};
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: `${category.label} blocks — SevenUI`,
    description: category.description,
    route: `/blocks/${group.id}/${category.id}`,
  }}
  layout={{ Header }}
>
  <div class="lg:grid lg:grid-cols-[260px_minmax(0,1fr)]">
    <BlocksSidebar activeGroup={group.id} activeCategory={category.id} />
    <div class="min-w-0">
      <BlocksPrefs />
      <header class="border-b border-border px-6 py-12 lg:px-10">
        <div class="max-w-2xl">
          <nav class="text-sm text-muted-foreground" aria-label="Breadcrumb">
            <a href="/blocks" class="hover:text-foreground hover:underline">Blocks</a>
            <span class="mx-1.5">/</span>
            <a href={`/blocks/${group.id}`} class="hover:text-foreground hover:underline">{group.label}</a>
            <span class="mx-1.5">/</span>
            <span class="text-foreground">{category.label}</span>
          </nav>
          <h1 class="mt-4 text-3xl font-semibold tracking-tight">{category.label}</h1>
          <p class="mt-2 text-muted-foreground">
            {category.description} {category.items.length} {category.items.length === 1 ? "block" : "blocks"} in this category.
          </p>
        </div>
      </header>
      <ProOffer />
      <div class="px-6 py-12 lg:px-10">
        <div class="divide-y divide-border">
          {category.items.map((item) => (
            <BlockFrame
              name={item.name}
              title={item.title}
              description={item.description}
              height={item.previewHeight}
              installItem={`pro/${item.name}`}
              previewUrl={`/previews/${item.name}`}
              badge="Pro"
            />
          ))}
        </div>
      </div>
      <BlocksThemeDock />
    </div>
  </div>
  <SiteDrawer route={`/blocks/${group.id}/${category.id}`}>
    <nav aria-label="Block categories">
      <BlocksSidebarNav activeGroup={group.id} activeCategory={category.id} />
    </nav>
  </SiteDrawer>
  <footer slot="footer"><SiteFooter /></footer>
</PageLayout>
