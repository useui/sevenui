---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import BlocksSidebar from "../../../components/blocks-sidebar.astro";
import CategoryIllustration from "../../../components/category-illustration.astro";
import SiteFooter from "../../../components/site-footer.astro";
import { groups } from "../_data";

export function getStaticPaths() {
  return groups.map((group) => ({ params: { group: group.id } }));
}

const { group: groupId } = Astro.params;
const group = groups.find((entry) => entry.id === groupId)!;
const { config } = data;

const navigation = {
  ...data.navigation,
  tabs: [
    { label: "Docs", path: "/docs", href: "/docs" },
    {
      label: "Components",
      path: "/docs/components",
      href: "/docs/components/button",
    },
    { label: "Blocks", path: "/blocks", href: "/blocks" },
  ],
};
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: `${group.label} blocks — SevenUI`,
    description: group.description,
    route: `/blocks/${group.id}`,
  }}
>
  <div class="lg:grid lg:grid-cols-[260px_minmax(0,1fr)]">
    <BlocksSidebar activeGroup={group.id} />
    <div class="min-w-0">
      <header class="border-b border-border px-6 py-12 lg:px-10">
        <div class="max-w-2xl">
          <nav class="text-sm text-muted-foreground" aria-label="Breadcrumb">
            <a href="/blocks" class="hover:text-foreground hover:underline">Blocks</a>
            <span class="mx-1.5">/</span>
            <span class="text-foreground">{group.label}</span>
          </nav>
          <h1 class="mt-4 text-3xl font-semibold tracking-tight">{group.label}</h1>
          <p class="mt-2 text-muted-foreground">
            {group.description} {group.items.length} {group.items.length === 1 ? "block" : "blocks"} in this group.
          </p>
        </div>
      </header>
      <div class="px-6 py-12 lg:px-10">
        <div class="grid max-w-5xl gap-6 sm:grid-cols-2">
          {group.categories.map((category) => (
            <a
              href={`/blocks/${group.id}/${category.id}`}
              class="flex flex-col gap-3 rounded-xl border border-border bg-background p-4 transition-colors hover:border-foreground/20"
            >
              <div class="flex aspect-[11/6] items-center justify-center overflow-hidden rounded-lg bg-muted/40">
                <div class="w-3/4">
                  <CategoryIllustration category={category.id} />
                </div>
              </div>
              <div>
                <h2 class="text-sm font-medium">{category.label}</h2>
                <p class="text-sm text-muted-foreground">{category.description}</p>
                <p class="mt-1 text-sm text-muted-foreground">
                  {category.items.length} {category.items.length === 1 ? "block" : "blocks"}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
  <footer slot="footer"><SiteFooter /></footer>
</PageLayout>
