---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import BlockFrame from "../../../components/block-frame.astro";
import BlocksSidebar from "../../../components/blocks-sidebar.astro";
import { groups, PREVIEW_HEIGHTS } from "../_data";

export function getStaticPaths() {
  return groups.flatMap((group) =>
    group.categories.map((category) => ({
      params: { group: group.id, category: category.id },
    })),
  );
}

const { group: groupId, category: categoryId } = Astro.params;
const group = groups.find((entry) => entry.id === groupId)!;
const category = group.categories.find((entry) => entry.id === categoryId)!;
const { config } = data;

const navigation = {
  ...data.navigation,
  tabs: [
    { label: "Docs", path: "/docs", href: "/docs" },
    {
      label: "Components",
      path: "/docs/components",
      href: "/docs/components/button",
    },
    { label: "Blocks", path: "/blocks", href: "/blocks" },
  ],
};
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  page={{
    title: `${category.label} blocks — SevenUI`,
    route: `/blocks/${group.id}/${category.id}`,
  }}
>
  <div class="mx-auto max-w-6xl px-6 py-12">
    <nav class="text-sm text-muted-foreground" aria-label="Breadcrumb">
      <a href="/blocks" class="hover:text-foreground hover:underline">Blocks</a>
      <span class="mx-1.5">/</span>
      <a href={`/blocks/${group.id}`} class="hover:text-foreground hover:underline">{group.label}</a>
      <span class="mx-1.5">/</span>
      <span class="text-foreground">{category.label}</span>
    </nav>
    <header class="mt-4 max-w-2xl">
      <h1 class="text-3xl font-semibold tracking-tight">{category.label}</h1>
      <p class="mt-2 text-muted-foreground">{category.description}</p>
    </header>
    <div class="mt-10 lg:grid lg:grid-cols-[220px_1fr] lg:gap-10">
      <BlocksSidebar activeGroup={group.id} activeCategory={category.id} />
      <div class="mt-8 grid gap-10 lg:mt-0">
        {category.items.map((item) => (
          <BlockFrame
            name={item.name}
            title={item.title}
            description={item.description}
            height={PREVIEW_HEIGHTS[item.name] ?? 560}
            sourcePath={item.files[0].path}
          />
        ))}
      </div>
    </div>
  </div>
</PageLayout>
