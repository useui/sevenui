---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Header from "../../components/blume/Header.astro";
import ComponentGalleryNav from "../../components/component-gallery-nav.astro";
import ComponentGallery from "../../components/component-gallery.astro";
import ExampleCard from "../../components/example-card.astro";
import SiteDrawer from "../../components/site-drawer.astro";
import SiteFooter from "../../components/site-footer.astro";
import { galleryComponent } from "./_data";

import Button01 from "../../../../packages/registry/components/button/button-01";
import button01Source from "../../../../packages/registry/components/button/button-01.tsx?raw";
import Button02 from "../../../../packages/registry/components/button/button-02";
import button02Source from "../../../../packages/registry/components/button/button-02.tsx?raw";
import Button03 from "../../../../packages/registry/components/button/button-03";
import button03Source from "../../../../packages/registry/components/button/button-03.tsx?raw";
import Button04 from "../../../../packages/registry/components/button/button-04";
import button04Source from "../../../../packages/registry/components/button/button-04.tsx?raw";

const SLUG = "button";
const meta = galleryComponent(SLUG);
const { config } = data;
// No tabs in the navigation prop: PageLayout gates its built-in tabs-only
// drawer on `navigation.tabs.length > 0`, and SiteDrawer replaces it below
// (blume's `syncDrawerInert` uses `querySelector`, so only one
// `[data-blume-nav-drawer]` may exist per page). The header is unaffected — it
// injects SITE_TABS itself rather than reading this prop.
const navigation = { ...data.navigation, tabs: [] };
const description = `Free, copy-and-go ${meta.label} components built on the SevenUI ${meta.label} primitive.`;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: `${meta.label} — SevenUI Components`, description, route: `/components/${SLUG}` }}
  layout={{ Header }}
>
  <ComponentGallery active={SLUG}>
    <header class="border-b border-border px-6 py-10 lg:px-10">
      <h1 class="text-3xl font-semibold tracking-tight">{meta.label}</h1>
      <p class="mt-2 max-w-2xl text-muted-foreground">
        {description}
        <a class="underline underline-offset-4" href={`/docs/components/${SLUG}`}>Read the primitive docs</a>.
      </p>
    </header>
    <div class="flex max-w-4xl flex-col gap-12 px-6 py-10 lg:px-10">
      <ExampleCard id="button-01" title="Loading button" code={button01Source}>
        <Button01 client:visible />
      </ExampleCard>
      <ExampleCard id="button-02" title="With icons" code={button02Source}>
        <Button02 client:visible />
      </ExampleCard>
      <ExampleCard id="button-03" title="Call to action pair" code={button03Source}>
        <Button03 client:visible />
      </ExampleCard>
      <ExampleCard id="button-04" title="Icon-only actions" code={button04Source}>
        <Button04 client:visible />
      </ExampleCard>
    </div>
  </ComponentGallery>
  <SiteDrawer route={`/components/${SLUG}`}>
    <ComponentGalleryNav active={SLUG} />
  </SiteDrawer>
  <footer slot="footer"><SiteFooter /></footer>
</PageLayout>
