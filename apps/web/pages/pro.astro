---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Header from "../components/blume/Header.astro";
import SiteFooter from "../components/site-footer.astro";
import { SITE_TABS } from "../components/site-tabs.ts";

const { config } = data;

const description =
  "Pre-order SevenUI Pro for $99 lifetime — the price rises to $249 once the Pro blocks catalog launches.";

// Sandbox link until production cutover — the ONLY place the checkout URL lives.
const CHECKOUT_URL =
  "https://sandbox-api.polar.sh/v1/checkout-links/polar_cl_MulHSqwF0DaO1vw3QaZ7LOcCarTPBp7fdSwTI2Nagty/redirect";

const features = [
  "Every Pro block, delivered to your license as the catalog rolls out",
  "Lifetime access — pay once, keep forever",
  "Locks in $99 before the price rises to $249 at launch",
  "License key issued immediately — view it anytime in your account",
];

const navigation = {
  ...data.navigation,
  tabs: SITE_TABS,
};
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: "Pro — SevenUI", description, route: "/pro" }}
  layout={{ Header }}
>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-semibold tracking-tight">SevenUI Pro</h1>
      <span class="inline-flex h-6 items-center rounded-full border border-border px-2.5 text-xs font-medium text-muted-foreground">Pre-order</span>
    </div>
    <p class="mt-2 text-muted-foreground">
      {description}
    </p>
    <div class="mt-8 rounded-xl border border-border p-6">
      <div class="flex items-baseline justify-between">
        <h2 class="text-lg font-semibold">Lifetime license</h2>
        <p class="text-3xl font-semibold">
          <s class="mr-2 text-lg font-normal text-muted-foreground" aria-hidden="true">$249</s>$99<span class="text-sm font-normal text-muted-foreground"> pre-order</span>
        </p>
      </div>
      <p class="mt-2 text-sm text-muted-foreground">
        Buy now for $99, once, and it's yours forever. The price becomes $249 the moment the
        Pro blocks catalog launches — pre-ordering locks in today's price. Your license key is
        issued immediately, and every Pro block ships to it automatically as the catalog rolls out.
      </p>
      <ul class="mt-4 grid gap-2 text-sm text-muted-foreground">
        {features.map((feature) => <li>{feature}</li>)}
      </ul>
      <a
        id="pro-buy"
        href={CHECKOUT_URL}
        class="mt-6 inline-flex h-10 w-full items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground hover:bg-primary/90"
      >Pre-order — $99</a>
      <p class="mt-3 text-center text-xs text-muted-foreground">
        Per-developer license, unlimited personal and commercial projects.
        Your key lives in <a href="/account" class="underline underline-offset-4">your account</a>.
      </p>
    </div>
    <section class="mt-12 grid gap-6 text-sm">
      <div>
        <h3 class="font-medium">License</h3>
        <p class="mt-1 text-muted-foreground">
          One license per developer, unlimited projects. Redistribution or resale of the source is not permitted.
        </p>
      </div>
    </section>
  </div>
  <footer slot="footer"><SiteFooter /></footer>
</PageLayout>

<script>
  import { getClerk } from "../lib/clerk";

  // Progressive enhancement only: signed-out visitors keep the plain
  // checkout link untouched. Signed-in visitors get the checkout
  // pre-filled so the Polar customer is created already matched to this
  // account, without a manual step on /account.
  async function enhanceBuyLink() {
    const buyLink = document.getElementById("pro-buy") as HTMLAnchorElement | null;
    if (!buyLink) return; // not on this page
    const clerk = await getClerk();
    const email = clerk.user?.primaryEmailAddress?.emailAddress;
    if (!email) return;
    const url = new URL(buyLink.href);
    url.searchParams.set("customer_email", email);
    url.searchParams.set("reference_id", clerk.user!.id);
    buyLink.href = url.toString();
  }

  document.addEventListener("astro:page-load", enhanceBuyLink);
  enhanceBuyLink();
</script>
