---
// One gallery card, top to bottom: the block's title (h2) + description as
// a plain header, then a resizable live-preview frame with a visible
// "track" showing the frame's original extent as it's narrowed — a plain
// bg-muted/30 tint, no outline of its own. (An earlier version traced the
// track's edge with a broken/segmented border, but with the toolbar now
// a full-track fixed bar and the handle sitting outside the box, that
// outline just collided with those corners and no longer carried its own
// meaning; the fixed bar + framed box + external handle already make the
// track's extent obvious geometrically, so the tint alone is enough.) The
// toolbar (width presets, the frame actions, and the install control) is
// attached to the top of the track and spans its FULL width — it does not
// resize with the frame, only the framed box below it does. The drag/resize
// handle sits OUTSIDE that box, in the track's own vacated area to its
// right, tracking the box's live edge.
//
// The iframe is INTERACTIVE by deliberate product decision (reverses an
// earlier a11y-motivated "inert" choice, now accepted by the owner): click
// inputs, toggle pricing tabs, type into OTP slots, right in the gallery.
// Because a cross-document iframe can swallow pointermove during a resize
// drag (setPointerCapture doesn't reliably retarget across that boundary in
// every engine), the scoped <style> below suppresses the iframe's
// pointer-events for exactly the duration of a drag, driven by the same
// data-dragging flag the script already toggles on the iframe's wrapper.
//
// The handle is authored BEFORE the box in source order even though it
// renders to the box's right. Tab order follows the DOM, and the iframe is
// a full application — with the handle last, reaching the control that
// resizes a preview meant tabbing through the entire preview first, six
// times over on a category page. Its position is set entirely from
// `style.left`, so moving it in source changes nothing visually.
//
// Source of truth for every width measurement (readout, aria-value*,
// preset bucketing, the min/max clamp) is the IFRAME's own content width,
// not the resize box's border-box width — the box is border-box with a
// border on every side, so its rendered width is always a couple of
// pixels wider than what actually renders inside it. Measuring that delta
// once per box (not hardcoding "2") is what makes "1024px" in the badge
// mean the block genuinely renders at 1024.
import { ArrowUpRight, Check, Link2, Maximize2, Monitor, RotateCw, Smartphone, Sparkles, Tablet } from "@lucide/astro";
import InstallControl from "./install-control.astro";

interface Props {
  name: string; // also the card's anchor id, which the permalink button copies
  title: string;
  description: string;
  height: number;
  installItem: string; // registry item id passed to installCommand(), e.g. "pro/dashboard-01"
  previewUrl: string; // iframe src + "open in new tab" target
  sourceUrl?: string; // GitHub source link; hidden when absent
  badge?: string; // optional chip rendered next to the title, e.g. "Pro"
}
const { name, title, description, height, installItem, previewUrl, sourceUrl, badge } = Astro.props;
// Single source of truth for the resize bounds, now expressed in IFRAME
// width (not box width) — interpolated into the box's data-min/data-max
// attributes, which the client script reads and converts to the
// equivalent box width using a runtime-measured border delta (the exact
// box↔iframe offset can't be known at build time). MIN_WIDTH is a FLOOR THE
// SCRIPT ENFORCES, deliberately not a CSS `min-width` on the box: `min-width`
// beats `max-width` in the cascade, so below a ~408px viewport the box rendered
// 360px inside a ~312px track — clipping the preview's right edge and flinging
// the handle past the card, which gave every phone a horizontal scrollbar. The
// script's clamp already computes the correct bound against the live track.
// The same three numbers define the preset/active-range boundaries: mobile
// ≤ 384, tablet 385–1023, desktop ≥ 1024 (up to the 1440 cap) — all iframe
// -width ranges.
const MIN_WIDTH = 360;
const MAX_WIDTH = 1440;

// Shared geometry for every icon control in the toolbar. Selected state is
// styled off `aria-pressed` alone — matching blocks-theme-dock.astro — rather
// than a mirrored `data-active` attribute. Two sources of truth for one state
// is how the visible half stays working while the ARIA half silently rots.
//
// Deliberately carries NO display utility: the tiered controls below compose
// `hidden @sm/card:inline-flex` onto it, and a baked-in `inline-flex` would sit
// in the same cascade layer as `hidden` — where source order in the class
// attribute counts for nothing and the generated stylesheet's order decides.
// `inline-flex` won that race, so every tiered control rendered at every width.
const ICON =
  "size-8 shrink-0 cursor-pointer items-center justify-center rounded-md border border-border text-muted-foreground outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
const ALWAYS = `${ICON} inline-flex`;
const PRESET = `${ALWAYS} aria-pressed:bg-muted aria-pressed:text-foreground`;
---

{/* `data-title` rather than reading the h2: the heading also contains the "Pro"
    badge, so its textContent is "Dashboard 01Pro". */}
<article
  id={name}
  class="flex scroll-mt-24 flex-col gap-4 py-10"
  data-block={name}
  data-title={title}
  data-preview-url={previewUrl}
>
  <div>
    <h2 class="flex items-center gap-2 text-sm font-medium">
      {title}
      {badge && (
        <span class="rounded-md bg-primary px-1.5 py-0.5 text-xs font-medium text-primary-foreground">
          {badge}
        </span>
      )}
    </h2>
    <p class="text-sm text-muted-foreground" data-block-description>{description}</p>
  </div>
  {/* `@container/card` (not a viewport breakpoint) drives the toolbar's tiers
      below: this track is ~684px at a 1024px viewport but ~312px at 360px, so a
      `lg:`-style rule would describe the wrong box entirely. Keep the container
      declaration HERE and leave [data-resize-frame]'s own `relative` alone —
      Chrome 129 removed the implicit containing block `container-type` used to
      create, and the handle is absolutely positioned against the frame. */}
  <div
    class="@container/card relative w-full rounded-xl bg-muted/30"
    style={`max-width: calc(${MAX_WIDTH}px + 2px);`}
    data-resize-wrapper
  >
    {/* Fixed h-11 rather than padding + wrap: the previous `flex-wrap` meant
        that once the control set outgrew the track, `justify-between` applied
        PER LINE — a lone trailing control slammed to one edge — and the bar's
        height, and so every card's height, changed with the breakpoint.
        Controls now drop out at container tiers instead, in reverse order of
        how often they're needed. `display: none` takes them out of the
        accessibility tree and the tab order for free, with none of the
        focus-loss window an overflow menu opens up.

        The tier thresholds are budgeted against the INSTALL CONTROL, not just
        against the icons. It is the only shrinkable item in the bar (everything
        else is `shrink-0`), so it absorbs any deficit alone, and its natural
        width is ~355px. Tiering on the icons alone put `@lg` at 512 and `@xl`
        at 576 — container widths where that 355px had not been earned yet — so
        each tier boundary made the bar TIGHTER as the window got WIDER: the
        command field dropped 377->266px at `@lg` and 329->258px at `@xl`, its
        global minimum. `@2xl` (672) and `@3xl` (768) clear 355px on the far
        side of every boundary, so each tier is now a net gain. A 1024px
        viewport is the case to keep in mind: the 260px sidebar appears there
        and the track falls to 684px, which must still land in a tier the
        install control fits in. */}
    <div class="flex h-11 items-center gap-2 rounded-t-xl border border-border bg-muted/30 px-3">
      <div class="hidden shrink-0 items-center gap-1 @2xl/card:flex" role="group" aria-label="Preview width">
        {/* The labels carry the RANGE each preset is pressed for, not the
            single width it snaps to — the button stays pressed anywhere in its
            bucket, so "768px" was describing a state the control never has on
            its own. Hints ride on `data-tip`, drawn by the one page-level
            tooltip node (see the Tooltips section of the script below). They
            were `title` before, which the UA draws for free but only after its
            own ~500ms-1s delay that no author can shorten. The two reasons
            `title` beat the tooltip spans it replaced still hold and are met
            here: the tip is `position: fixed`, so no ancestor can clip it, and
            it is purely decorative — the accessible name is the `sr-only` span
            on each control, unchanged. WCAG 1.4.13 is satisfied rather than
            side-stepped: Escape dismisses it, and it is `pointer-events: none`
            so it cannot be hovered away. */}
        <button type="button" data-preset="384" aria-pressed="false" data-tip="Mobile — up to 384px" class={PRESET}>
          <span class="sr-only">Preview at mobile width, up to 384 pixels</span>
          <Smartphone class="size-4" stroke-width={1.5} aria-hidden="true" />
        </button>
        <button type="button" data-preset="768" aria-pressed="false" data-tip="Tablet — 385 to 1023px" class={PRESET}>
          <span class="sr-only">Preview at tablet width, 385 to 1023 pixels</span>
          <Tablet class="size-4" stroke-width={1.5} aria-hidden="true" />
        </button>
        <button type="button" data-preset="max" aria-pressed="true" data-tip="Desktop — 1024px and up" class={PRESET}>
          <span class="sr-only">Preview at desktop width, 1024 pixels and up</span>
          <Monitor class="size-4" stroke-width={1.5} aria-hidden="true" />
        </button>
      </div>

      <div class="ml-auto flex min-w-0 items-center gap-1">
        {/* The `data-copy-idle`/`data-copy-done` pair is the install control's
            confirmation pattern (install-control.astro), reused verbatim: the
            script swaps `hidden` between the two icons and the accessible name
            never changes, so the result is announced through the live region
            rather than by mutating the button's name under anyone tabbed to it.
            These two copied silently before — only the install command
            confirmed, which made the other two feel broken. */}
        <button type="button" data-prompt data-tip="Copy prompt for an AI agent" class={`${ICON} hidden @3xl/card:inline-flex`}>
          <span class="sr-only">Copy a prompt describing {title} for an AI coding agent</span>
          <Sparkles class="size-4" stroke-width={1.5} aria-hidden="true" data-copy-idle />
          <Check class="hidden size-4" stroke-width={1.5} aria-hidden="true" data-copy-done />
        </button>
        <button type="button" data-permalink data-tip="Copy link to this block" class={`${ICON} hidden @3xl/card:inline-flex`}>
          <span class="sr-only">Copy a link to {title}</span>
          <Link2 class="size-4" stroke-width={1.5} aria-hidden="true" data-copy-idle />
          <Check class="hidden size-4" stroke-width={1.5} aria-hidden="true" data-copy-done />
        </button>
        <button type="button" data-refresh data-tip="Reload preview" class={`${ICON} hidden @sm/card:inline-flex`}>
          <span class="sr-only">Reload the {title} preview</span>
          <RotateCw class="size-4" stroke-width={1.5} aria-hidden="true" />
        </button>
        {/* A toggle, so it reports pressed state rather than changing its name:
            the same control is how you leave full screen again. */}
        <button
          type="button"
          data-fullscreen
          aria-pressed="false"
          data-tip="Full screen"
          class={`${ICON} hidden @sm/card:inline-flex aria-pressed:bg-muted aria-pressed:text-foreground`}
        >
          <span class="sr-only">Show {title} full screen</span>
          <Maximize2 class="size-4" stroke-width={1.5} aria-hidden="true" />
        </button>
        {/* Renamed from "Open full-screen preview": with a real full-screen
            control one row over, two differently-behaving buttons shared a
            name — and screen-reader users only ever got this one's, since the
            old tooltip was aria-hidden. */}
        <a href={previewUrl} target="_blank" rel="noopener noreferrer" data-tip="Open in new tab" class={ALWAYS}>
          <span class="sr-only">Open the {title} preview in a new tab</span>
          <ArrowUpRight class="size-4" stroke-width={1.5} aria-hidden="true" />
        </a>
        {sourceUrl && (
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer" data-tip="View source on GitHub" class={ALWAYS}>
            <span class="sr-only">View the {title} source on GitHub</span>
            <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z"
              ></path>
            </svg>
          </a>
        )}
        <InstallControl item={installItem} title={title} />
      </div>
    </div>

    <div class="relative" data-resize-frame>
      {/* Authored before the box so keyboard users reach it without first
          traversing the whole preview application; `style.left` alone decides
          where it renders. It lives OUTSIDE the clip layer below so its
          straddling half is never shaved. */}
      <div
        class="group absolute top-1/2 z-10 flex h-12 w-4 -translate-y-1/2 cursor-ew-resize touch-none items-center justify-center outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring"
        style="left: calc(100% - 0.5rem);"
        data-resize-handle
        role="separator"
        aria-orientation="vertical"
        aria-label="Resize preview"
        aria-valuemin={MIN_WIDTH}
        tabindex="0"
      >
        <span
          class="h-12 w-1.5 rounded-full bg-border transition-colors group-hover:bg-foreground/30 group-focus-visible:bg-foreground/50"
          aria-hidden="true"
        ></span>
      </div>
      <!-- Clip layer: rounds and clips the track area's outer bottom
           corners. The box inside keeps SQUARE corners, so when it is
           narrowed its inner bottom-right corner meets the track with a
           flat edge (no orphaned rounding mid-track); at the track's own
           edges this layer clips both the box and the underlay ring to
           the shared rounded silhouette. -->
      <div class="overflow-hidden rounded-b-xl">
        <!-- Track outline: a decorative OVERLAY ring framing the full
             track area, painted ABOVE the box (z-10, pointer-events
             none). At full width it traces the exact same 1px perimeter
             as the box's own border — including the rounded bottom
             corners the square-cornered box cannot draw once the clip
             layer shaves them — so the eye reads one continuous edge.
             Narrowed, the ring frames the vacated area while the box's
             own border draws the inner edge. Never affects the box's
             geometry or the script's width math. -->
        <div
          class="pointer-events-none absolute inset-0 z-10 rounded-b-xl border border-t-0 border-border"
          aria-hidden="true"
        ></div>
        <div
          class="relative overflow-hidden border border-t-0 border-border bg-background"
          style="width: 100%; max-width: 100%;"
          data-resize-box
          data-min={MIN_WIDTH}
          data-max={MAX_WIDTH}
        >
          <div class="relative" data-preview-wrap>
            {/* `data-src`, not `src`: the loader below gates how many previews
                fetch at once. A category page renders every block live, and
                letting six full applications boot simultaneously is the
                difference between a gallery that scrolls and one that stalls.
                `loading="lazy"` is gone with it — the IntersectionObserver
                decides, and lazy would additionally re-arm itself on any later
                attribute write. */}
            <iframe
              data-src={previewUrl}
              title={`${title} preview`}
              style={`height: ${height}px`}
              class="w-full"
            ></iframe>
            <span
              class="pointer-events-none absolute top-2 right-2 z-10 rounded bg-foreground px-1.5 py-0.5 font-mono text-xs text-background tabular-nums opacity-0 transition-opacity duration-150"
              data-width-readout
            >
              100%
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  /* Drag-in-progress suppression: while data-dragging is set on the
     iframe's wrapper (toggled by the script below in pointerdown/endDrag),
     the iframe itself stops receiving pointer events so a fast drag can't
     get swallowed by the now-interactive cross-document iframe — restored
     the instant the drag ends. The width readout stays visible for the
     same duration even if the pointer strays off the handle mid-drag. */
  [data-dragging="true"] iframe {
    pointer-events: none;
  }
  [data-dragging="true"] [data-width-readout] {
    opacity: 1;
  }

  /* The handle is a SIBLING of the box (outside it, in the track's own area),
     not a descendant, so it can't reach the readout through a plain Tailwind
     peer-hover/peer-focus-visible sibling selector — the readout is nested two
     levels down inside a DIFFERENT sibling. :has() on their shared ancestor
     (data-resize-frame) bridges that gap regardless of DOM order. */
  [data-resize-frame]:has([data-resize-handle]:hover) [data-width-readout],
  [data-resize-frame]:has([data-resize-handle]:focus-visible) [data-width-readout] {
    opacity: 1;
  }

  /* Full screen, in two flavours that must look identical:
     `:fullscreen` when the Fullscreen API is available, and `[data-fs]` — a
     plain fixed overlay — when it is not. iPhone has no Fullscreen API and will
     not get one (WebKit #212934 is WONTFIX; iOS supports it on iPad only), so
     the fallback is not an edge case, it is every iPhone.

     The wrapper's own build-time `max-width` has to go, or the promoted element
     would sit in a 1442px column in the middle of the screen. The BOX's width is
     deliberately NOT forced here: the UA's `!important` rules apply only to the
     fullscreen element itself, so a box still pinned to the 384px mobile preset
     would letterbox — but pinning it back with another `!important` would make
     the width presets silently inert in full screen, since applyWidth writes an
     ordinary inline width. The script clears the pinned width on the way in and
     restores it on the way out instead, which keeps every resize control live at
     the larger size. */
  [data-resize-wrapper]:fullscreen,
  [data-resize-wrapper][data-fs] {
    display: flex;
    flex-direction: column;
    max-width: none !important;
    background: var(--background);
  }
  [data-resize-wrapper][data-fs] {
    position: fixed;
    inset: 0;
    z-index: 50;
  }
  [data-resize-wrapper]:fullscreen [data-resize-frame],
  [data-resize-wrapper][data-fs] [data-resize-frame] {
    flex: 1;
    min-height: 0;
  }
  [data-resize-wrapper]:fullscreen [data-resize-frame] > div,
  [data-resize-wrapper][data-fs] [data-resize-frame] > div,
  [data-resize-wrapper]:fullscreen [data-preview-wrap],
  [data-resize-wrapper][data-fs] [data-preview-wrap],
  [data-resize-wrapper]:fullscreen [data-resize-box],
  [data-resize-wrapper][data-fs] [data-resize-box] {
    height: 100%;
  }
  [data-resize-wrapper]:fullscreen iframe,
  [data-resize-wrapper][data-fs] iframe {
    height: 100% !important;
  }
  [data-resize-wrapper]:fullscreen::backdrop {
    background: var(--background);
  }
</style>

<script>
  // Resizable preview frames: drag (pointer events + setPointerCapture),
  // ArrowLeft/ArrowRight (24px steps), Home/End, or a width preset resize the
  // box so that the IFRAME inside it — not the box itself — lands at the
  // target width, clamped between the box's own data-min/data-max (IFRAME
  // -width bounds; single source of truth, see the component frontmatter) and
  // whatever the track can actually offer.
  //
  // Every lookup (box, iframe, handle) is keyed off the shared
  // data-resize-wrapper (the track) rather than a direct DOM relationship,
  // because the handle is a SIBLING of the box (outside it, in the track's own
  // area), not a descendant — a plain .closest() from the handle can't reach
  // the box. The same applies to the PRESET buttons, which live in the toolbar:
  // an earlier version reconciled their pressed state with
  // `box.querySelectorAll("[data-preset]")`, which matched nothing at all, so
  // the buttons never reflected the frame's width.
  //
  // A ResizeObserver on each IFRAME (not the box — the box is border-box
  // with a border on every side, so its rendered width is always a few
  // px wider than what actually renders inside it) keeps the width
  // readout, the separator's aria-value*, the external handle's position,
  // AND each preset button's pressed state in sync for every trigger — drag,
  // keyboard, presets, AND browser/viewport resize — chosen over a window
  // "resize" listener because it also reacts when a shrinking track clamps the
  // box via its own max-width, and it fires once on initial observe, covering
  // the initial-load reading for free.
  //
  // Astro dedupes this script to a single copy per page regardless of how
  // many BlockFrame cards render, and every handler below is delegated on
  // `document`, so a ClientRouter navigation that swaps in fresh cards needs no
  // re-binding. Plain DOM, no dependencies.
  import { PACKAGE_MANAGER_KEY, PACKAGE_MANAGERS, readPackageManager } from "../lib/package-manager.ts";

  type PackageManager = (typeof PACKAGE_MANAGERS)[number];

  function getWrapper(el: Element): HTMLElement | null {
    return el.closest<HTMLElement>("[data-resize-wrapper]");
  }

  function getBox(el: Element): HTMLElement | null {
    return getWrapper(el)?.querySelector<HTMLElement>("[data-resize-box]") ?? null;
  }

  function getIframe(el: Element): HTMLIFrameElement | null {
    return getWrapper(el)?.querySelector<HTMLIFrameElement>("iframe") ?? null;
  }

  function getHandle(el: Element): HTMLElement | null {
    return getWrapper(el)?.querySelector<HTMLElement>("[data-resize-handle]") ?? null;
  }

  function minWidth(box: HTMLElement): number {
    return Number(box.dataset.min) || 360;
  }

  function maxWidth(box: HTMLElement): number {
    return Number(box.dataset.max) || 1440;
  }

  // Only write when the value actually changes. Unconditional setAttribute on a
  // focused control re-announces its state on every observer tick, which is
  // what makes a screen reader chatty during a drag.
  function setAttr(el: Element, attribute: string, value: string) {
    if (el.getAttribute(attribute) !== value) el.setAttribute(attribute, value);
  }

  // The box is border-box with a border on every side, so its own
  // rendered width is always a fixed few px wider than the iframe's real
  // content width inside it. Measuring this once per box (rather than
  // hardcoding "2") keeps every width computation exact regardless of the
  // box's actual border-width, and cached so a hot drag loop doesn't
  // re-read layout on every pointermove.
  const borderDeltaCache = new WeakMap<HTMLElement, number>();
  function borderDelta(box: HTMLElement, iframe: HTMLIFrameElement): number {
    let delta = borderDeltaCache.get(box);
    if (delta === undefined) {
      delta = box.offsetWidth - iframe.clientWidth;
      borderDeltaCache.set(box, delta);
    }
    return delta;
  }

  // The widest iframe this track can currently show, honouring both the item's
  // own cap and what the track physically offers. Shared by the clamp and the
  // observer so `aria-valuemax` can never disagree with the enforced bound.
  function trackMax(wrapper: HTMLElement, box: HTMLElement, iframe: HTMLIFrameElement): number {
    return Math.min(wrapper.getBoundingClientRect().width - borderDelta(box, iframe), maxWidth(box));
  }

  // Resize the box so the IFRAME lands at exactly targetIframePx, clamped
  // to [data-min, data-max] (iframe-width bounds) and to whatever width
  // the track can actually offer the iframe once the border delta is
  // subtracted. When the track is narrower than the floor, the track wins —
  // the box must never render wider than the space it has.
  function applyWidth(
    box: HTMLElement,
    wrapper: HTMLElement,
    iframe: HTMLIFrameElement,
    targetIframePx: number,
  ) {
    const delta = borderDelta(box, iframe);
    const maxIframePx = trackMax(wrapper, box, iframe);
    const floor = Math.min(minWidth(box), maxIframePx);
    const clampedIframePx = Math.min(Math.max(targetIframePx, floor), maxIframePx);
    box.style.width = `${clampedIframePx + delta}px`;
    // Keep the straddling handle glued to the box edge synchronously —
    // the ResizeObserver reconciles a tick later, but during a fast drag
    // this is what keeps the handle from visibly trailing the edge.
    const handle = getHandle(box);
    if (handle) handle.style.left = `${clampedIframePx + delta - 8}px`;
  }

  // Which preset's range contains this width: mobile ≤384, tablet
  // 385–1023, desktop ≥1024. Matches each button's own data-preset value
  // ("384" | "768" | "max") so the caller can compare directly.
  function presetBucket(width: number): "384" | "768" | "max" {
    if (width <= 384) return "384";
    if (width <= 1023) return "768";
    return "max";
  }

  const readoutObserver = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const iframe = entry.target as HTMLIFrameElement;
      const box = getBox(iframe);
      const wrapper = getWrapper(iframe);
      if (!box || !wrapper) continue;
      const handle = getHandle(iframe);
      const readout = box.querySelector<HTMLElement>("[data-width-readout]");
      const width = Math.round(entry.contentRect.width);
      const available = Math.round(trackMax(wrapper, box, iframe));
      if (readout) readout.textContent = `${width}px`;
      if (handle) {
        setAttr(handle, "aria-valuenow", String(width));
        setAttr(handle, "aria-valuemax", String(available));
        // A separator whose min exceeds its max is an invalid range object, and
        // that is exactly what a track narrower than the floor produces.
        setAttr(handle, "aria-valuemin", String(Math.min(minWidth(box), available)));
        setAttr(handle, "aria-valuetext", `${width} pixels`);
        // Dragging can't do anything when the track has nothing to give back.
        // An inline `display` rather than the `hidden` attribute, because the
        // handle carries Tailwind's `flex` utility, which outranks the UA's
        // `[hidden] { display: none }`.
        const resizable = available > minWidth(box);
        handle.style.display = resizable ? "" : "none";
        handle.tabIndex = resizable ? 0 : -1;
        // Keep the external handle straddling the box's live right edge
        // (half over the border, half over the track) — it's a sibling
        // positioned in the frame region, so nothing moves it
        // automatically. 8 = half the 16px hit zone.
        handle.style.left = `${box.getBoundingClientRect().width - 8}px`;
      }
      // The presets live in the TOOLBAR, which is a sibling of the frame — they
      // are reachable from the wrapper, never from the box.
      const bucket = presetBucket(width);
      wrapper.querySelectorAll<HTMLElement>("[data-preset]").forEach((button) => {
        setAttr(button, "aria-pressed", String(button.dataset.preset === bucket));
      });
    }
  });

  // ---------------------------------------------------------------------------
  // Preview loading
  // ---------------------------------------------------------------------------
  // Every card renders a live application, and a category page renders several.
  // Booting them all at once starves the ones actually on screen, so previews
  // are fetched from a queue: observed when they come within a viewport of the
  // fold, then started at most MAX_CONCURRENT at a time.
  const MAX_CONCURRENT = 3;
  const pending: HTMLIFrameElement[] = [];
  let inFlight = 0;

  function pump() {
    while (inFlight < MAX_CONCURRENT && pending.length > 0) {
      const iframe = pending.shift()!;
      const src = iframe.dataset.src;
      if (!src) continue;
      inFlight += 1;
      // Both events, once: a frame that never fires `load` (blocked, aborted)
      // would otherwise hold a slot forever and stall the rest of the page.
      let settled = false;
      const settle = () => {
        if (settled) return;
        settled = true;
        inFlight -= 1;
        pump();
      };
      iframe.addEventListener("load", settle, { once: true });
      iframe.addEventListener("error", settle, { once: true });
      iframe.src = src;
    }
  }

  const loadObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        loadObserver.unobserve(entry.target);
        pending.push(entry.target as HTMLIFrameElement);
      }
      pump();
    },
    // A full viewport of lead time: by the time a card scrolls into view its
    // preview has usually finished booting.
    { rootMargin: "100% 0px" },
  );

  // Per-page init. This module script runs ONCE per browser session —
  // Blume's layouts mount Astro's ClientRouter, so cross-page navigation
  // swaps the DOM without re-running scripts, and iframes on the new page
  // would never be observed (readouts stuck at the SSR "100%", previews never
  // fetched). Re-observe on every astro:page-load; observe() is idempotent per
  // target, and the call at module scope still covers a load where no
  // ClientRouter runs.
  function initFrames() {
    document.querySelectorAll<HTMLIFrameElement>("[data-preview-wrap] iframe").forEach((iframe) => {
      readoutObserver.observe(iframe);
      if (iframe.dataset.src && !iframe.src) loadObserver.observe(iframe);
    });
    syncInstallControls();
  }
  initFrames();
  document.addEventListener("astro:page-load", initFrames);
  // ResizeObserver holds STRONG references to its targets, so without this every
  // gallery navigation pins another page's worth of detached iframes in memory.
  document.addEventListener("astro:before-swap", () => {
    // The tip node is replaced by the swap; leaving the old one visible would
    // paint a stale hint over the incoming page.
    hideTip();
    readoutObserver.disconnect();
    loadObserver.disconnect();
    pending.length = 0;
    inFlight = 0;
    // The fallback full screen locks <html> scrolling, and <html> survives the
    // swap — navigating out of it would leave the next page unscrollable.
    document.documentElement.style.overflow = "";
  });

  // ---------------------------------------------------------------------------
  // Announcements
  // ---------------------------------------------------------------------------
  // One page-level live region (rendered by blocks-prefs.astro). It must be
  // cleared before each write, or a second identical message is silent.
  function announce(message: string) {
    const region = document.getElementById("sevenui-announcer");
    if (!region) return;
    region.textContent = "";
    requestAnimationFrame(() => {
      region.textContent = message;
    });
  }

  // ---------------------------------------------------------------------------
  // Tooltips
  // ---------------------------------------------------------------------------
  // One page-level tooltip node (rendered by blocks-prefs.astro) serving every
  // `[data-tip]` control, driven by the same delegated document listeners as
  // the rest of this script. No delay: `title`, which this replaced, is drawn
  // by the UA after ~500ms in Chrome and ~1s in Safari, and that timing is not
  // author-controllable.
  //
  // Positioned with a transform on a `position: fixed` node, so showing it
  // never touches layout and no ancestor's overflow can clip it. Preferred side
  // is ABOVE the control: the toolbar sits on top of the preview iframe, so a
  // tip drawn below covers the very thing the control acts on. It flips below
  // only when the viewport top would cut it off, and it is clamped 8px inside
  // both horizontal edges.
  const TIP_GAP = 6;

  function tipNode(): HTMLElement | null {
    return document.getElementById("sevenui-tip");
  }

  // The control the tip currently belongs to. Kept because both handlers below
  // fire on movement WITHIN a control — a button and the icon inside it are
  // separate event targets — and without it entering the icon would hide and
  // immediately re-show the tip, which reads as a flicker.
  let tipOwner: HTMLElement | null = null;

  function hideTip() {
    tipOwner = null;
    const tip = tipNode();
    if (!tip || tip.hidden) return;
    tip.hidden = true;
    tip.textContent = "";
  }

  function showTip(trigger: HTMLElement) {
    const tip = tipNode();
    // `tipFlash` is the transient "Copied" confirmation; it shadows the static
    // hint rather than overwriting it, so the flash can never clobber a tip
    // that syncInstallControls() rewrites on its own schedule.
    const text = trigger.dataset.tipFlash || trigger.dataset.tip;
    // The copy button's tip is written by syncInstallControls() once the
    // package manager is known, so an empty one here just means "not yet".
    if (!tip || !text) return hideTip();
    // Re-render when the text changed under us (a "Copied" flash on the button
    // the pointer is already resting on), skip when it is the same tip again.
    if (tipOwner === trigger && !tip.hidden && tip.textContent === text) return;
    tipOwner = trigger;
    tip.textContent = text;
    tip.hidden = false;
    // Measured AFTER unhiding: a `hidden` element has no box, so a rect read
    // before this point is all zeroes and the tip lands in the corner.
    const anchor = trigger.getBoundingClientRect();
    const box = tip.getBoundingClientRect();
    const left = Math.min(
      Math.max(8, anchor.left + anchor.width / 2 - box.width / 2),
      Math.max(8, window.innerWidth - box.width - 8),
    );
    const above = anchor.top - box.height - TIP_GAP;
    const top = above < 8 ? anchor.bottom + TIP_GAP : above;
    tip.style.transform = `translate(${Math.round(left)}px, ${Math.round(top)}px)`;
  }

  // Show (or refresh) the tip for a control the user is demonstrably still on.
  // Used by the copy confirmation, which changes the tip's text out from under
  // a pointer that never moved.
  function showTipIfActive(trigger: HTMLElement) {
    if (trigger.matches(":hover, :focus-visible")) showTip(trigger);
  }

  function tipTarget(target: EventTarget | null): HTMLElement | null {
    const el = target as Element | null;
    return el?.closest ? el.closest<HTMLElement>("[data-tip]") : null;
  }

  // `pointerover`/`pointerout` rather than mouseenter/leave so one delegated
  // pair covers every control, present and future. Touch is excluded outright:
  // a tap fires pointerover with no matching pointerout, which would strand the
  // tip on screen — the same reason Base UI disables tooltips on touch.
  document.addEventListener("pointerover", (event) => {
    if (event.pointerType === "touch") return;
    const trigger = tipTarget(event.target);
    if (trigger) showTip(trigger);
    else hideTip();
  });
  document.addEventListener("pointerout", (event) => {
    const trigger = tipTarget(event.target);
    if (!trigger) return;
    // Leaving the button for its own icon is still "inside" as far as the tip
    // is concerned; only a move that lands outside the control dismisses it.
    const next = event.relatedTarget as Node | null;
    if (next && trigger.contains(next)) return;
    hideTip();
  });
  // Keyboard parity: focusin/focusout, not focus/blur, because those do not
  // bubble and so cannot be delegated.
  document.addEventListener("focusin", (event) => {
    const trigger = tipTarget(event.target);
    if (trigger) showTip(trigger);
    else hideTip();
  });
  document.addEventListener("focusout", (event) => {
    const trigger = tipTarget(event.target);
    const next = event.relatedTarget as Node | null;
    if (trigger && next && trigger.contains(next)) return;
    hideTip();
  });
  // Capture phase: this must run whatever the control's own handler does, and
  // a click on the fullscreen or open-in-new-tab control moves the page out
  // from under a tip that would otherwise stay put.
  document.addEventListener("click", hideTip, true);
  // Also capture, so scrolling INSIDE any container counts, not just the page.
  window.addEventListener("scroll", hideTip, true);
  window.addEventListener("resize", hideTip);

  // Visible confirmation for a copy control: swap its idle icon for the check,
  // and — if the tip is open on it, which it is whenever the click came from a
  // pointer — flash "Copied" in place of the hint. Both revert together.
  // `announce()` covers the non-visual half; this covers the half a sighted
  // user actually watches for.
  const COPIED_MS = 1600;
  const flashTimers = new WeakMap<HTMLElement, number>();

  function flashCopied(button: HTMLElement) {
    const idle = button.querySelector("[data-copy-idle]");
    const done = button.querySelector("[data-copy-done]");
    idle?.classList.add("hidden");
    done?.classList.remove("hidden");
    button.dataset.tipFlash = "Copied";
    // Not `tipOwner === button`: the capture-phase click handler above has
    // already dismissed the tip by the time this runs. Ask the DOM whether the
    // control is still the one being pointed at (or keyboard-focused, where no
    // tip was open to dismiss) and re-open it on the flash text.
    showTipIfActive(button);
    // Re-copying before the flash ends restarts it rather than letting the
    // first timer cut the second confirmation short.
    clearTimeout(flashTimers.get(button));
    flashTimers.set(
      button,
      window.setTimeout(() => {
        idle?.classList.remove("hidden");
        done?.classList.add("hidden");
        delete button.dataset.tipFlash;
        showTipIfActive(button);
        flashTimers.delete(button);
      }, COPIED_MS),
    );
  }

  async function copy(text: string, message: string) {
    try {
      await navigator.clipboard.writeText(text);
      announce(message);
      return true;
    } catch {
      // Clipboard unavailable (permissions/insecure context); nothing to undo.
      announce("Copy failed — the clipboard is unavailable.");
      return false;
    }
  }

  // ---------------------------------------------------------------------------
  // Package manager preference
  // ---------------------------------------------------------------------------
  // WHICH command each control displays is decided in CSS off `[data-pm]` on
  // <html> (see blocks-prefs.astro), so nothing here touches text. This only
  // has to keep the parts CSS cannot reach in sync: the copy button's tooltip,
  // and the menu's aria-checked.
  function currentPm(): PackageManager {
    const value = document.documentElement.dataset.pm;
    return (PACKAGE_MANAGERS as readonly string[]).includes(value ?? "")
      ? (value as PackageManager)
      : readPackageManager(localStorage);
  }

  function commandFor(control: HTMLElement, pm: PackageManager): string {
    return control.dataset[`cmd${pm[0].toUpperCase()}${pm.slice(1)}`] ?? "";
  }

  function syncInstallControls() {
    const pm = currentPm();
    document.querySelectorAll<HTMLElement>("[data-install]").forEach((control) => {
      control.querySelector("[data-copy]")?.setAttribute("data-tip", commandFor(control, pm));
      control.querySelectorAll<HTMLElement>("[data-pm-option]").forEach((option) => {
        const checked = option.dataset.pmOption === pm;
        setAttr(option, "aria-checked", String(checked));
        option.tabIndex = checked ? 0 : -1;
      });
    });
  }

  function setPm(pm: PackageManager) {
    try {
      localStorage.setItem(PACKAGE_MANAGER_KEY, pm);
    } catch {
      // Storage blocked; the choice still applies for this page view.
    }
    document.documentElement.dataset.pm = pm;
    syncInstallControls();
  }

  function openMenu(control: HTMLElement, open: boolean) {
    const menu = control.querySelector<HTMLElement>("[data-pm-menu]");
    const trigger = control.querySelector<HTMLElement>("[data-pm-trigger]");
    if (!menu || !trigger) return;
    menu.hidden = !open;
    trigger.setAttribute("aria-expanded", String(open));
    if (open) {
      syncInstallControls();
      menu.querySelector<HTMLElement>('[aria-checked="true"]')?.focus();
    }
  }

  function closeAllMenus(except?: Element) {
    document.querySelectorAll<HTMLElement>("[data-install]").forEach((control) => {
      if (control !== except) openMenu(control, false);
    });
  }

  // ---------------------------------------------------------------------------
  // Full screen
  // ---------------------------------------------------------------------------
  // requestFullscreen goes on the WRAPPER, not the iframe: only the fullscreen
  // element and its descendants render, so promoting the iframe alone would
  // take the toolbar with it. The iframe node is never moved either — inserting
  // an <iframe> elsewhere creates a new nested navigable, throwing away the
  // preview's state and paying a fresh load.
  //
  // `allowfullscreen` is deliberately absent from the iframe: the spec checks
  // the node document of the element being promoted, which is this document.
  // Only a call from INSIDE the frame would need the permissions-policy grant.
  function enterFullscreen(wrapper: HTMLElement) {
    if (document.fullscreenEnabled) {
      // Must stay synchronous with the click — awaiting anything first spends
      // the transient activation.
      wrapper.requestFullscreen().catch(() => fallbackFullscreen(wrapper, true));
      return;
    }
    fallbackFullscreen(wrapper, true);
  }

  // Releasing the pinned box width is what stops a card that was left on the
  // 384px preset from opening as a letterboxed strip. Stashing it first is what
  // lets the card come back exactly as the reader left it.
  function setFullscreenLayout(wrapper: HTMLElement, on: boolean) {
    const box = wrapper.querySelector<HTMLElement>("[data-resize-box]");
    const button = wrapper.querySelector<HTMLElement>("[data-fullscreen]");
    if (box) {
      if (on) {
        wrapper.dataset.prevWidth = box.style.width;
        box.style.width = "";
      } else {
        box.style.width = wrapper.dataset.prevWidth ?? "";
        delete wrapper.dataset.prevWidth;
      }
    }
    if (button) setAttr(button, "aria-pressed", String(on));
  }

  // Fires for the button, for Escape, and for the browser's own full-screen UI
  // alike — the one place that reconciles layout with the actual state.
  document.addEventListener("fullscreenchange", () => {
    document.querySelectorAll<HTMLElement>("[data-resize-wrapper]").forEach((wrapper) => {
      const on = document.fullscreenElement === wrapper;
      if (on !== (wrapper.dataset.prevWidth !== undefined)) setFullscreenLayout(wrapper, on);
    });
  });

  // iPhone has no Fullscreen API (WebKit #212934, WONTFIX), so this plain fixed
  // overlay is not a rare fallback — it is every iPhone. It does not make the
  // rest of the page inert, so background content stays reachable by screen
  // reader; Escape and the toolbar's own button are the ways out.
  function fallbackFullscreen(wrapper: HTMLElement, on: boolean) {
    if (on) {
      wrapper.dataset.fs = "";
      document.documentElement.style.overflow = "hidden";
    } else {
      delete wrapper.dataset.fs;
      document.documentElement.style.overflow = "";
    }
    setFullscreenLayout(wrapper, on);
  }

  function exitFullscreen(wrapper: HTMLElement) {
    if (document.fullscreenElement === wrapper) {
      void document.exitFullscreen();
    } else {
      fallbackFullscreen(wrapper, false);
    }
  }

  // ---------------------------------------------------------------------------
  // Delegated toolbar actions
  // ---------------------------------------------------------------------------
  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    if (!target?.closest) return;

    const preset = target.closest<HTMLElement>("[data-preset]");
    if (preset) {
      const box = getBox(preset);
      const wrapper = getWrapper(preset);
      const iframe = getIframe(preset);
      if (!box || !wrapper || !iframe || !preset.dataset.preset) return;
      // "max" (desktop) resolves to the same 1440px-or-wrapper-width cap
      // applyWidth already enforces for every other trigger — Infinity always
      // loses to that clamp, so this is just "as wide as allowed".
      const px =
        preset.dataset.preset === "max" ? Number.POSITIVE_INFINITY : Number(preset.dataset.preset);
      applyWidth(box, wrapper, iframe, px);
      return;
    }

    const trigger = target.closest<HTMLElement>("[data-pm-trigger]");
    if (trigger) {
      const control = trigger.closest<HTMLElement>("[data-install]")!;
      const menu = control.querySelector<HTMLElement>("[data-pm-menu]")!;
      const willOpen = menu.hidden;
      closeAllMenus(control);
      openMenu(control, willOpen);
      return;
    }

    const option = target.closest<HTMLElement>("[data-pm-option]");
    if (option) {
      const control = option.closest<HTMLElement>("[data-install]")!;
      setPm(option.dataset.pmOption as PackageManager);
      openMenu(control, false);
      control.querySelector<HTMLElement>("[data-pm-trigger]")?.focus();
      return;
    }

    const copyButton = target.closest<HTMLElement>("[data-copy]");
    if (copyButton) {
      const control = copyButton.closest<HTMLElement>("[data-install]")!;
      const pm = currentPm();
      void copy(
        commandFor(control, pm),
        `Copied the ${pm} install command for ${control.dataset.title ?? "this block"}.`,
      ).then((ok) => {
        if (ok) flashCopied(copyButton);
      });
      return;
    }

    const permalink = target.closest<HTMLElement>("[data-permalink]");
    if (permalink) {
      const article = permalink.closest<HTMLElement>("[data-block]")!;
      const url = `${location.origin}${location.pathname}#${article.id}`;
      void copy(url, `Copied a link to ${article.dataset.title ?? "this block"}.`).then((ok) => {
        if (ok) flashCopied(permalink);
      });
      return;
    }

    const prompt = target.closest<HTMLElement>("[data-prompt]");
    if (prompt) {
      const article = prompt.closest<HTMLElement>("[data-block]")!;
      void copy(buildPrompt(article), `Copied an agent prompt for ${article.dataset.title ?? "this block"}.`).then(
        (ok) => {
          if (ok) flashCopied(prompt);
        },
      );
      return;
    }

    const refresh = target.closest<HTMLElement>("[data-refresh]");
    if (refresh) {
      const iframe = getIframe(refresh);
      if (!iframe?.src) return;
      // reload() is initiated from INSIDE the frame, so it never re-runs the
      // "process the iframe attributes" steps — which is what makes the two
      // obvious alternatives wrong. Re-assigning `src` re-arms `loading` and
      // can silently skip an offscreen frame, and appending a cache-buster
      // produces a NEW url, which pushes an entry onto the PARENT's history.
      try {
        const view = iframe.contentWindow!;
        const y = view.scrollY;
        iframe.addEventListener(
          "load",
          () => {
            try {
              view.scrollTo(0, y);
            } catch {
              // The reloaded document may not be reachable; the reload still happened.
            }
          },
          { once: true },
        );
        view.location.reload();
      } catch {
        iframe.src = iframe.src;
      }
      announce("Preview reloaded.");
      return;
    }

    const fullscreen = target.closest<HTMLElement>("[data-fullscreen]");
    if (fullscreen) {
      const wrapper = getWrapper(fullscreen);
      if (!wrapper) return;
      if (document.fullscreenElement === wrapper || wrapper.dataset.fs !== undefined) {
        exitFullscreen(wrapper);
      } else {
        enterFullscreen(wrapper);
      }
      return;
    }

    closeAllMenus();
  });

  // The prompt is assembled client-side so the preview link is absolute against
  // whatever origin the page is actually served from, and so the command
  // matches the reader's own package manager. No block source is included —
  // the point is to tell an agent how to install the block correctly, not to
  // hand it the paid files.
  function buildPrompt(article: HTMLElement): string {
    const control = article.querySelector<HTMLElement>("[data-install]");
    const pm = currentPm();
    const title = article.dataset.title ?? article.id;
    const description = article.querySelector<HTMLElement>("[data-block-description]")?.textContent?.trim();
    const preview = new URL(article.dataset.previewUrl ?? "/", location.href).href;
    // `null` marks a line that may not exist; "" is a blank line the prompt
    // wants. Filtering on `!== ""` collapsed every paragraph break into one
    // wall of text.
    const lines: (string | null)[] = [
      `Add the SevenUI block "${title}" to this project.`,
      "",
      description ?? null,
      `Live preview: ${preview}`,
      "",
      "Install it with the shadcn CLI:",
      control ? commandFor(control, pm) : null,
      "",
      "components.json must declare the registry first:",
      '  "registries": { "@sevenui": "https://sevenui.dev/r/{name}.json" }',
      "",
      "Rules when integrating it:",
      "- SevenUI is built on Base UI, not Radix. Use the primitives the CLI writes",
      "  under the project's ui directory; do not add @radix-ui packages.",
      "- Tailwind CSS v4: there is no tailwind.config.js, theme values live in CSS",
      "  via @theme.",
      "- The block reads theme tokens (--primary, --muted, --radius, …). Map it onto",
      "  the tokens this project already defines; do not hardcode colors or radii.",
      "- Keep the block's own markup structure; restyle through tokens instead.",
    ];
    return lines.filter((line): line is string => line !== null).join("\n");
  }

  // ---------------------------------------------------------------------------
  // Resize interactions
  // ---------------------------------------------------------------------------
  let dragging: {
    handle: HTMLElement;
    wrapper: HTMLElement;
    box: HTMLElement;
    iframe: HTMLIFrameElement;
    pointerId: number;
    grabOffset: number;
  } | null = null;

  document.addEventListener("pointerdown", (event) => {
    const handle = (event.target as Element | null)?.closest?.("[data-resize-handle]");
    if (!handle) {
      // An outside press dismisses any open package-manager menu, matching the
      // theme dock's non-modal behaviour.
      if (!(event.target as Element | null)?.closest?.("[data-install]")) closeAllMenus();
      return;
    }
    const wrapper = getWrapper(handle);
    const box = getBox(handle);
    const iframe = getIframe(handle);
    if (!wrapper || !box || !iframe) return;
    (handle as HTMLElement).setPointerCapture(event.pointerId);
    // Remember where on the handle the user grabbed relative to the box's
    // right edge, so the edge follows the pointer without the initial jump
    // a raw clientX mapping would cause on a straddling handle.
    const grabOffset = box.getBoundingClientRect().right - event.clientX;
    dragging = { handle: handle as HTMLElement, wrapper, box, iframe, pointerId: event.pointerId, grabOffset };
    // data-dragging goes on the iframe's wrapper (an ANCESTOR of the
    // iframe), not the readout — the scoped <style> above needs an
    // ancestor-of-iframe selector to suppress the iframe's pointer-events
    // during the drag; setting it on a sibling wouldn't match.
    box.querySelector<HTMLElement>("[data-preview-wrap]")?.setAttribute("data-dragging", "true");
    document.body.style.userSelect = "none";
    // preventDefault suppresses text selection, but it also suppresses the
    // focus the press would otherwise give the handle — which is why the arrow
    // keys did nothing after a mouse drag. Focus it explicitly.
    event.preventDefault();
    (handle as HTMLElement).focus();
  });

  document.addEventListener("pointermove", (event) => {
    if (!dragging || event.pointerId !== dragging.pointerId) return;
    const rect = dragging.wrapper.getBoundingClientRect();
    const delta = borderDelta(dragging.box, dragging.iframe);
    // The pointer drives the box's right edge, preserving the grab point
    // on the straddling handle; convert to the equivalent iframe target
    // by removing the border delta.
    const targetBoxPx = event.clientX + dragging.grabOffset - rect.left;
    applyWidth(dragging.box, dragging.wrapper, dragging.iframe, targetBoxPx - delta);
  });

  function endDrag(event: PointerEvent) {
    if (!dragging || event.pointerId !== dragging.pointerId) return;
    if (dragging.handle.hasPointerCapture(event.pointerId)) {
      dragging.handle.releasePointerCapture(event.pointerId);
    }
    dragging.box.querySelector<HTMLElement>("[data-preview-wrap]")?.removeAttribute("data-dragging");
    dragging = null;
    document.body.style.userSelect = "";
  }
  document.addEventListener("pointerup", endDrag);
  document.addEventListener("pointercancel", endDrag);

  document.addEventListener("keydown", (event) => {
    // Unconditional and first: WCAG 1.4.13 requires the tip be dismissible
    // without moving the pointer or focus, and the Escape branches below all
    // return early on their own conditions.
    if (event.key === "Escape") hideTip();
    const target = event.target as Element | null;
    // keydown can land on `document` when nothing is focused, which has no
    // .closest — so probe for it rather than assuming an Element.
    const within = (selector: string) =>
      target?.closest ? target.closest<HTMLElement>(selector) : null;

    const menuOption = within("[data-pm-option]");
    if (menuOption) {
      const control = menuOption.closest<HTMLElement>("[data-install]")!;
      const options = [...control.querySelectorAll<HTMLElement>("[data-pm-option]")];
      const index = options.indexOf(menuOption);
      const focus = (next: number) => {
        event.preventDefault();
        options[(next + options.length) % options.length].focus();
      };
      if (event.key === "ArrowDown") return focus(index + 1);
      if (event.key === "ArrowUp") return focus(index - 1);
      if (event.key === "Home") return focus(0);
      if (event.key === "End") return focus(options.length - 1);
      if (event.key === "Escape") {
        event.preventDefault();
        openMenu(control, false);
        control.querySelector<HTMLElement>("[data-pm-trigger]")?.focus();
        return;
      }
    }

    if (event.key === "Escape") {
      closeAllMenus();
      const fallback = document.querySelector<HTMLElement>("[data-resize-wrapper][data-fs]");
      if (fallback) {
        exitFullscreen(fallback);
        fallback.querySelector<HTMLElement>("[data-fullscreen]")?.focus();
      }
      return;
    }

    const handle = within("[data-resize-handle]");
    if (!handle) return;
    const wrapper = getWrapper(handle);
    const box = getBox(handle);
    const iframe = getIframe(handle);
    if (!wrapper || !box || !iframe) return;
    const currentIframePx = iframe.getBoundingClientRect().width;
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault();
      applyWidth(box, wrapper, iframe, currentIframePx + (event.key === "ArrowRight" ? 24 : -24));
    } else if (event.key === "Home") {
      event.preventDefault();
      applyWidth(box, wrapper, iframe, minWidth(box));
    } else if (event.key === "End") {
      event.preventDefault();
      applyWidth(box, wrapper, iframe, Number.POSITIVE_INFINITY);
    }
  });
</script>
