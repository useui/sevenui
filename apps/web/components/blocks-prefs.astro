---
// Page-level plumbing shared by every install control in the /blocks gallery:
// the package-manager preference, and the one live region the toolbars
// announce through. Exactly ONE instance per page, on every page that renders
// a <BlockFrame /> — today only /blocks/[group]/[category]; the other two
// /blocks pages show category cards, which carry no install control. Render it
// FIRST in the content column: the inline script below has to execute before
// the cards are parsed, or a non-default preference repaints them.
//
// Why the preference is applied in CSS rather than by rewriting text:
// a category page renders up to six cards, each with an install control, and
// `storage` events do not fire in the document that made the change — so a
// JS-per-card approach would need its own same-page broadcast AND would flash
// on first paint. Instead every control renders ALL FOUR commands in SSR markup
// and `[data-pm]` on <html> selects one. N cards stay in sync with zero
// per-card JS, there is no flash in either direction, and a ClientRouter swap
// costs one attribute write.
import { DEFAULT_PACKAGE_MANAGER, PACKAGE_MANAGER_KEY, PACKAGE_MANAGERS } from "../lib/package-manager.ts";
import PackageManagerIcons from "./package-manager-icons.astro";
---

{/* The <symbol> sprite every install control's <use href="#pm-icon-*"> points
    at. It belongs here, not in the control, because one copy per page is the
    whole point. */}
<PackageManagerIcons />

{/* The single live region every toolbar announces through. Two non-obvious
    rules govern it: it must already exist and be EMPTY before the text changes
    (a region injected together with its content announces nothing), and it must
    be cleared between writes or a second identical message is silent — the
    script in block-frame.astro does both. */}
<div id="sevenui-announcer" role="status" aria-live="polite" aria-atomic="true" class="sr-only"></div>

<style is:global>
  /* One rule per entry in PACKAGE_MANAGERS (lib/package-manager.ts). The
     `:not([data-pm])` rule is what renders before the inline script runs, so it
     must name DEFAULT_PACKAGE_MANAGER; the script only ever narrows from it. */
  .pm-only {
    display: none;
  }
  :root:not([data-pm]) .pm-only-pnpm,
  [data-pm="pnpm"] .pm-only-pnpm,
  [data-pm="npm"] .pm-only-npm,
  [data-pm="yarn"] .pm-only-yarn,
  [data-pm="bun"] .pm-only-bun {
    display: inline;
  }
</style>

{/* `is:inline` is load-bearing: without it Astro bundles this into a deferred
    module that runs after first paint, which is exactly the flash it exists to
    prevent. `define:vars` keeps the key, the default and the valid set from
    drifting away from lib/package-manager.ts, which an inline script cannot
    import. */}
<script
  is:inline
  define:vars={{
    key: PACKAGE_MANAGER_KEY,
    fallback: DEFAULT_PACKAGE_MANAGER,
    valid: PACKAGE_MANAGERS,
  }}
>
  (() => {
    const apply = () => {
      let stored = null;
      try {
        stored = localStorage.getItem(key);
      } catch {
        // Storage blocked (private mode, third-party cookie policy); use the default.
      }
      document.documentElement.dataset.pm = valid.includes(stored) ? stored : fallback;
    };
    apply();
    // `astro:after-swap`, NOT `astro:page-load`: the swapped-in DOM exists but
    // has not painted yet, so re-applying here is invisible. `page-load` fires
    // after the new page is on screen, which would flash. Guarded because
    // ClientRouter re-executes inline scripts in the swapped document.
    if (!window.__sevenuiPmBound) {
      window.__sevenuiPmBound = true;
      document.addEventListener("astro:after-swap", apply);
    }
  })();
</script>
