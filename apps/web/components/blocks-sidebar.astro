---
// Category sidebar for the /blocks gallery (directory, group, and category
// pages). One <details> per group listing its categories with block counts.
// Below `lg` the whole tree collapses into a single "Categories" disclosure;
// at `lg` and up it renders as an always-visible left column, flush against
// the viewport edge, separated from the content column by a border (docs-
// style structural line, not the landing's decorative rail/crop-mark
// apparatus), and sticky so it stays visible while the content scrolls.
// The sticky offset (`top-16` / `100dvh-4rem`) mirrors Blume's own docs
// sidebar (node_modules/blume/src/components/layout/RootLayout.astro),
// whose nav drawer uses the same `lg:sticky lg:top-16
// lg:h-[calc(100dvh-4rem)]` pairing for its 4rem-tall header.
import { ChevronRight } from "@lucide/astro";
import BlocksSidebarNav from "./blocks-sidebar-nav.astro";

interface Props {
  activeGroup?: string;
  activeCategory?: string;
}
const { activeGroup, activeCategory } = Astro.props;
---

<div
  class="border-b border-border px-6 py-6 lg:sticky lg:top-16 lg:h-[calc(100dvh-4rem)] lg:overflow-y-auto lg:border-b-0 lg:border-r lg:px-5 lg:py-8"
>
  <details class="group lg:hidden">
    <summary
      class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-md border border-border bg-background px-3 py-2 text-sm font-medium text-foreground [&::-webkit-details-marker]:hidden"
    >
      <span>Categories</span>
      <ChevronRight
        class="size-3.5 shrink-0 text-muted-foreground transition-transform duration-150 group-open:rotate-90"
        aria-hidden="true"
      />
    </summary>
    <nav class="mt-2" aria-label="Block categories">
      <BlocksSidebarNav activeGroup={activeGroup} activeCategory={activeCategory} />
    </nav>
  </details>
  <nav class="hidden lg:block" aria-label="Block categories">
    <BlocksSidebarNav activeGroup={activeGroup} activeCategory={activeCategory} />
  </nav>
</div>
