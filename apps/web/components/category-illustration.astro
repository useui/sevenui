---
// Small wireframe illustration for a blocks category card. Pure inline SVG,
// theme-safe (currentColor only, no media queries) so it reads correctly in
// both light and dark. Unknown category ids fall back to a generic
// three-line placeholder.
interface Props {
  category: string;
}
const { category } = Astro.props;
---

{
  category === "auth" ? (
    <svg viewBox="0 0 220 120" class="h-full w-full" aria-hidden="true">
      <rect
        x="60"
        y="14"
        width="100"
        height="92"
        rx="8"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="text-muted-foreground/40"
      />
      <rect x="76" y="38" width="68" height="8" rx="4" fill="currentColor" class="text-muted-foreground/30" />
      <rect x="76" y="56" width="68" height="8" rx="4" fill="currentColor" class="text-muted-foreground/30" />
      <rect x="76" y="80" width="68" height="12" rx="6" fill="currentColor" class="text-muted-foreground/50" />
    </svg>
  ) : category === "hero" ? (
    <svg viewBox="0 0 220 120" class="h-full w-full" aria-hidden="true">
      <rect x="50" y="24" width="120" height="10" rx="5" fill="currentColor" class="text-muted-foreground/50" />
      <rect x="65" y="44" width="90" height="6" rx="3" fill="currentColor" class="text-muted-foreground/30" />
      <rect x="75" y="56" width="70" height="6" rx="3" fill="currentColor" class="text-muted-foreground/30" />
      <rect x="72" y="76" width="34" height="16" rx="4" fill="currentColor" class="text-muted-foreground/50" />
      <rect
        x="114"
        y="76"
        width="34"
        height="16"
        rx="4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="text-muted-foreground/40"
      />
    </svg>
  ) : category === "pricing" ? (
    <svg viewBox="0 0 220 120" class="h-full w-full" aria-hidden="true">
      <rect
        x="14"
        y="20"
        width="58"
        height="84"
        rx="6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="text-muted-foreground/30"
      />
      <rect x="81" y="12" width="58" height="92" rx="6" fill="currentColor" class="text-muted-foreground/10" />
      <rect
        x="81"
        y="12"
        width="58"
        height="92"
        rx="6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="text-muted-foreground/50"
      />
      <rect x="89" y="22" width="42" height="10" rx="5" fill="currentColor" class="text-muted-foreground/50" />
      <rect
        x="148"
        y="20"
        width="58"
        height="84"
        rx="6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="text-muted-foreground/30"
      />
    </svg>
  ) : (
    <svg viewBox="0 0 220 120" class="h-full w-full" aria-hidden="true">
      <rect x="50" y="42" width="120" height="8" rx="4" fill="currentColor" class="text-muted-foreground/30" />
      <rect x="50" y="58" width="120" height="8" rx="4" fill="currentColor" class="text-muted-foreground/30" />
      <rect x="50" y="74" width="80" height="8" rx="4" fill="currentColor" class="text-muted-foreground/30" />
    </svg>
  )
}
