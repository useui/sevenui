---
// Temporary landing page, rendered through Blume's PageLayout so it shares
// the site chrome (header, theme, search). The docs live under /docs; the
// header tabs below are scoped to this page only.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;

const navigation = {
  ...data.navigation,
  tabs: [
    { label: "Docs", path: "/docs", href: "/docs" },
    {
      label: "Components",
      path: "/docs/components",
      href: "/docs/components/button",
    },
  ],
};
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: config.title, description: config.description }}
>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-6 py-24 text-center">
    <h1 class="text-4xl font-semibold tracking-tight">SevenUI</h1>
    <p class="text-muted-foreground mt-4 text-lg">
      Base UI powered components, distributed through the shadcn registry.
    </p>
    <a
      href="/docs"
      class="bg-primary text-primary-foreground hover:bg-primary/90 mt-8 inline-flex h-10 items-center rounded-md px-6 text-sm font-medium"
    >
      Read the docs
    </a>
  </section>
</PageLayout>
