---
// Temporary landing page. The docs live under /docs (see basePath in
// blume.config.ts); this placeholder holds the root until the real
// landing ships.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SevenUI</title>
    <meta
      name="description"
      content="Base UI powered components, distributed through the shadcn registry."
    />
    <style>
      body {
        margin: 0;
        display: grid;
        place-items: center;
        min-height: 100dvh;
        font-family: ui-sans-serif, system-ui, sans-serif;
        background: #fff;
        color: #09090b;
      }
      @media (prefers-color-scheme: dark) {
        body {
          background: #09090b;
          color: #fafafa;
        }
      }
      main {
        text-align: center;
        padding: 2rem;
      }
      h1 {
        font-size: 2rem;
        letter-spacing: -0.025em;
        margin: 0 0 0.5rem;
      }
      p {
        margin: 0 0 1.5rem;
        opacity: 0.7;
      }
      a {
        color: inherit;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>SevenUI</h1>
      <p>Base UI powered components, distributed through the shadcn registry.</p>
      <a href="/docs">Read the docs →</a>
    </main>
  </body>
</html>
