---
// Landing page on Blume's PageLayout: the site chrome (header, theme,
// search) comes from the layout; the shadcn component tokens the showcase
// needs come from the root theme.css. Header tabs are scoped to this page.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import { Logomark } from "../components/logomark.tsx";
import LandingShowcase from "../components/landing-showcase.tsx";
import CopyCommand from "../components/copy-command.tsx";

const { config } = data;

const navigation = {
  ...data.navigation,
  tabs: [
    { label: "Docs", path: "/docs", href: "/docs" },
    {
      label: "Components",
      path: "/docs/components",
      href: "/docs/components/button",
    },
  ],
};

const footerComponents = [
  "button",
  "input",
  "select",
  "combobox",
  "checkbox",
  "switch",
  "slider",
  "table",
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: config.title, description: config.description }}
>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-6 pt-24 pb-20 text-center">
    <Logomark className="mb-8 h-12 w-auto" />
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
      Base UI primitives.<br />shadcn workflow.
    </h1>
    <p class="mt-5 max-w-xl text-lg text-balance text-muted-foreground">
      SevenUI is a registry of accessible React components built exclusively
      on Base UI — installed with the CLI you already use.
    </p>
    <div class="mt-9 flex w-full max-w-md flex-col items-center gap-3 sm:flex-row">
      <a
        href="/docs"
        class="inline-flex h-10 shrink-0 items-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Get started
      </a>
      <CopyCommand client:load command="npx shadcn add @sevenui/button" />
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-6 pb-24">
    <p class="mb-4 font-mono text-xs tracking-widest text-muted-foreground uppercase">
      Live from the registry — click around
    </p>
    <LandingShowcase client:load />
  </section>

  <section class="border-t">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-20 lg:grid-cols-2 lg:gap-16">
      <div class="flex max-w-md flex-col justify-center gap-4">
        <h2 class="text-2xl font-semibold tracking-tight">
          Same CLI. Different primitives.
        </h2>
        <p class="text-muted-foreground">
          Components are distributed as source through the shadcn registry and
          use the same CSS variables, so they drop into an existing shadcn
          project. Underneath, every part is a Base UI primitive — accessible,
          unstyled, and maintained by the Radix team's successors at MUI.
        </p>
      </div>
      <div class="flex flex-col justify-center gap-3">
        <CopyCommand client:visible command="npx shadcn add @sevenui/theme" />
        <CopyCommand client:visible command="npx shadcn add @sevenui/form" />
        <p class="font-mono text-xs text-muted-foreground">
          30 components · MIT · no runtime dependency on SevenUI
        </p>
      </div>
    </div>
  </section>

  <footer slot="footer" class="border-t">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-3">
        <span class="inline-flex items-center gap-2 font-semibold">
          <Logomark className="h-5 w-auto" /> SevenUI
        </span>
        <p class="max-w-xs text-sm text-muted-foreground">
          Base UI powered components, distributed through the shadcn registry.
        </p>
      </div>
      <nav aria-label="Components" class="flex flex-col gap-2 text-sm">
        <span class="mb-1 font-medium">Components</span>
        {
          footerComponents.map((name) => (
            <a
              class="text-muted-foreground transition-colors hover:text-foreground"
              href={`/docs/components/${name}`}
            >
              {name.charAt(0).toUpperCase() + name.slice(1).replace("-", " ")}
            </a>
          ))
        }
        <a class="text-muted-foreground transition-colors hover:text-foreground" href="/docs">
          All components →
        </a>
      </nav>
      <nav aria-label="Resources" class="flex flex-col gap-2 text-sm">
        <span class="mb-1 font-medium">Resources</span>
        <a class="text-muted-foreground transition-colors hover:text-foreground" href="/docs">
          Documentation
        </a>
        <a
          class="text-muted-foreground transition-colors hover:text-foreground"
          href="/docs/installation"
        >
          Installation
        </a>
        <a
          class="text-muted-foreground transition-colors hover:text-foreground"
          href="/docs/theming"
        >
          Theming
        </a>
        <a
          class="text-muted-foreground transition-colors hover:text-foreground"
          href="https://github.com/useui/sevenui"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </nav>
      <nav aria-label="Built with" class="flex flex-col gap-2 text-sm">
        <span class="mb-1 font-medium">Built on</span>
        <a
          class="text-muted-foreground transition-colors hover:text-foreground"
          href="https://base-ui.com"
          rel="noopener noreferrer"
        >
          Base UI
        </a>
        <a
          class="text-muted-foreground transition-colors hover:text-foreground"
          href="https://ui.shadcn.com/docs/registry"
          rel="noopener noreferrer"
        >
          shadcn registry
        </a>
        <a
          class="text-muted-foreground transition-colors hover:text-foreground"
          href="https://tailwindcss.com"
          rel="noopener noreferrer"
        >
          Tailwind CSS
        </a>
      </nav>
    </div>
    <div class="border-t">
      <p class="mx-auto w-full max-w-6xl px-6 py-6 text-xs text-muted-foreground">
        MIT License © 2026 SevenUI
      </p>
    </div>
  </footer>
</PageLayout>
